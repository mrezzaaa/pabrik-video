    "@remotion/renderer": "^4.0.220",
    "@remotion/three": "4.0.538",
    "@types/three": "0.169.0",
    "autoprefixer": "^10.6.1",
    "bullmq": "^5.81.5",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.475.0",
    "msedge-tts": "^2.1.0",
    "next": "15.1.7",
    "openai": "^4.85.4",
    "playwright": "^1.50.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.220",
    "tailwind-merge": "^2.6.0",
    "three": "0.169.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
