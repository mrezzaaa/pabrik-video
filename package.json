{
  "name": "pabrik-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"next,worker,stream\" -c \"cyan,magenta,yellow\" \"next dev -p 2000\" \"tsx watch src/queues/video-worker.ts\" \"stream-engine/.venv/bin/python stream-engine/main.py\"",
    "dev:web": "next dev -p 2000",
    "dev:stream": "stream-engine/.venv/bin/python stream-engine/main.py",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "worker": "tsx watch src/queues/video-worker.ts",
    "studio": "remotion studio src/remotion/index.ts",
    "check:tech": "tsx scripts/check-tech-storyboard.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "^4.0.220",
