# Pabrik Video Environment Variables
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://pabrik:pabrik_secret@postgres:5432/pabrik_video?schema=public"

# Redis
REDIS_URL="redis://redis:6379"
REDIS_HOST=redis
REDIS_PORT=6379

# OmniRoute AI Router (OpenAI SDK Compatible)
OMNIROUTE_BASE_URL="http://host.docker.internal:20128/v1"
OMNIROUTE_API_KEY="sk-omniroute-pabrik-local"
OMNIROUTE_MODEL="auto"

# SearXNG
SEARXNG_URL="http://searxng:8080"

# UnlimitedTTS & Fallback Edge-TTS
UNLIMITEDTTS_LANGUAGE=id-ID
UNLIMITEDTTS_VOICE=Ethan
UNLIMITEDTTS_SPEED=1.1

# Pexels Video (Optional B-Roll)
PEXELS_API_KEY=""

# Remotion Configuration
REMOTION_CONCURRENCY=2
REMOTION_FPS=30

# Gaya video: kitabedah (default; 3D X-Ray Hologram universal) | dynamic / classic (foto/footage SearXNG/Pexels + HUD)
PIPELINE_STYLE=kitabedah
# Renderer WebGL Remotion: angle (macOS, GPU Metal) | swangle (Linux/Docker tanpa GPU) | swiftshader | egl
# Kosongkan untuk auto: macOS=angle, selain itu=swangle.
REMOTION_GL=
