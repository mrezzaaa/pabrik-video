# Pabrik Video — environment variables
# Salin ke .env.local untuk development, atau .env untuk docker compose.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:2000
NEXT_PUBLIC_VOICE_LABEL=alloy

# PostgreSQL (port host 5433)
DATABASE_URL="postgresql://pabrik:pabrik_secret@localhost:5433/pabrik_video?schema=public"

# Redis + BullMQ
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379

# SearXNG (format JSON harus aktif)
SEARXNG_URL="http://localhost:8080"

# OmniRoute — gateway LLM OpenAI-compatible di host
OMNIROUTE_BASE_URL="http://localhost:20128/v1"
OMNIROUTE_API_KEY="sk-omniroute-pabrik-local"
OMNIROUTE_PRIMARY_MODEL="auto"
OMNIROUTE_FAST_MODEL="auto"
OMNIROUTE_MODEL="auto"

# VoiceStudio — TTS utama di host
VOICE_DEFAULT_ID="alloy"
VOICESTUDIO_BASE_URL="http://localhost:3900/v1"
VOICESTUDIO_VOICE_NAME="Alloy"
VOICESTUDIO_MODEL="omnivoice"
VOICESTUDIO_SPEED=1.05
VOICESTUDIO_API_KEY=""

# Fallback UnlimitedTTS (edge-tts CLI)
UNLIMITEDTTS_LANGUAGE=id-ID
UNLIMITEDTTS_VOICE=Ethan
UNLIMITEDTTS_VOICE_ID="id-ID-ArdiNeural"
UNLIMITEDTTS_SPEED=1.1

# Remotion
REMOTION_CONCURRENCY=2
REMOTION_FPS=30
# macOS: angle | Linux/Docker tanpa GPU: swangle
REMOTION_GL="angle"

# Worker
WORKER_CONCURRENCY=1
