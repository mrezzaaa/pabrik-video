datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum JobStatus {
  PENDING
  STAGE_1_RECON
  STAGE_2_DIRECTOR
  STAGE_3_TTS_SYNC
  STAGE_4_ASSETS
  STAGE_5_RENDER
  STREAMING
  COMPLETED
  FAILED
}

model VideoJob {
  id              String      @id @default(cuid())
  topic           String
  modelId         String      @default("auto")
  pexelsApiKey    String?
  status          JobStatus   @default(PENDING)
  progress        Int         @default(0)
  currentStage    String?     @default("PENDING")
  errorMessage    String?
  
  // Pipeline artifacts
  searchQueries   Json?
  knowledgeBase   Json?
  storyboard      Json?
  audioMetadata   Json?
  assetsMetadata  Json?
  videoProps      Json?
  
  // Final render outputs
  renderOutputUrl String?
  renderDurationMs Int?
  
  // Telemetry logs
  logs            JobLog[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model JobLog {
  id        String    @id @default(cuid())
  jobId     String
  job       VideoJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage     String
  level     String    @default("INFO") // INFO, WARN, ERROR, TELEMETRY
  message   String
  metadata  Json?
  timestamp DateTime  @default(now())

  @@index([jobId])
  @@index([timestamp])
}
